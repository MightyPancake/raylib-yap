// Port of raylib's official examples/audio/audio_music_stream.c
// Run from the repo root so the "examples/resources/..." path resolves.
import raylib

i32 fn main() {
    i32 screenWidth = 800;
    i32 screenHeight = 450;

    InitWindow(screenWidth, screenHeight, c"raylib [audio] example - music stream");
    InitAudioDevice();

    Music music = LoadMusicStream(c"examples/resources/country.mp3");
    PlayMusicStream(music);

    f32 timePlayed = 0.0;
    bool pause = false;

    f32 pan = 0.0;
    SetMusicPan(music, pan);

    f32 volume = 0.8;
    SetMusicVolume(music, volume);

    SetTargetFPS(30);

    while (!WindowShouldClose()) {
        UpdateMusicStream(music);

        if (IsKeyPressed(KEY_SPACE)) {
            StopMusicStream(music);
            PlayMusicStream(music);
        }

        if (IsKeyPressed(KEY_P)) {
            pause = !pause;
            if (pause) PauseMusicStream(music);
            else ResumeMusicStream(music);
        }

        if (IsKeyDown(KEY_LEFT)) {
            pan -= 0.05;
            if (pan < -1.0) pan = -1.0;
            SetMusicPan(music, pan);
        } else if (IsKeyDown(KEY_RIGHT)) {
            pan += 0.05;
            if (pan > 1.0) pan = 1.0;
            SetMusicPan(music, pan);
        }

        if (IsKeyDown(KEY_DOWN)) {
            volume -= 0.05;
            if (volume < 0.0) volume = 0.0;
            SetMusicVolume(music, volume);
        } else if (IsKeyDown(KEY_UP)) {
            volume += 0.05;
            if (volume > 1.0) volume = 1.0;
            SetMusicVolume(music, volume);
        }

        timePlayed = GetMusicTimePlayed(music) / GetMusicTimeLength(music);
        if (timePlayed > 1.0) timePlayed = 1.0;

        BeginDrawing();
        ClearBackground(RAYWHITE);

        DrawText(c"MUSIC SHOULD BE PLAYING!", 255, 150, 20, LIGHTGRAY);

        DrawText(c"LEFT-RIGHT for PAN CONTROL", 320, 74, 10, DARKBLUE);
        DrawRectangle(300, 100, 200, 12, LIGHTGRAY);
        DrawRectangleLines(300, 100, 200, 12, GRAY);
        DrawRectangle((300.0 + (pan + 1.0) / 2.0 * 200.0 - 5.0).(i32), 92, 10, 28, DARKGRAY);

        DrawRectangle(200, 200, 400, 12, LIGHTGRAY);
        DrawRectangle(200, 200, (timePlayed * 400.0).(i32), 12, MAROON);
        DrawRectangleLines(200, 200, 400, 12, GRAY);

        DrawText(c"PRESS SPACE TO RESTART MUSIC", 215, 250, 20, LIGHTGRAY);
        DrawText(c"PRESS P TO PAUSE/RESUME MUSIC", 208, 280, 20, LIGHTGRAY);

        DrawText(c"UP-DOWN for VOLUME CONTROL", 320, 334, 10, DARKGREEN);
        DrawRectangle(300, 360, 200, 12, LIGHTGRAY);
        DrawRectangleLines(300, 360, 200, 12, GRAY);
        DrawRectangle((300.0 + volume * 200.0 - 5.0).(i32), 352, 10, 28, DARKGRAY);

        EndDrawing();
    }

    UnloadMusicStream(music);
    CloseAudioDevice();
    CloseWindow();

    ret 0;
}
