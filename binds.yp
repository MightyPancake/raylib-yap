none fn InitWindow(i32 width, i32 height, byte@ title);
none fn CloseWindow();
bool fn WindowShouldClose();
bool fn IsWindowReady();
bool fn IsWindowFullscreen();
bool fn IsWindowHidden();
bool fn IsWindowMinimized();
bool fn IsWindowMaximized();
