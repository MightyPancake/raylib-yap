// C bindings from raylib.h

bind type rAudioBuffer
bind type rAudioProcessor

bind struct Vector2 {
    f32 x,
    f32 y,
}

bind struct Vector3 {
    f32 x,
    f32 y,
    f32 z,
}

bind struct Vector4 {
    f32 x,
    f32 y,
    f32 z,
    f32 w,
}

bind struct Matrix {
    f32 m0,
    f32 m4,
    f32 m8,
    f32 m12,
    f32 m1,
    f32 m5,
    f32 m9,
    f32 m13,
    f32 m2,
    f32 m6,
    f32 m10,
    f32 m14,
    f32 m3,
    f32 m7,
    f32 m11,
    f32 m15,
}

bind struct Color {
    byte r,
    byte g,
    byte b,
    byte a,
}

bind struct Rectangle {
    f32 x,
    f32 y,
    f32 width,
    f32 height,
}

bind struct Image {
    none@ data,
    i32 width,
    i32 height,
    i32 mipmaps,
    i32 format,
}

bind struct Texture {
    i32 id,
    i32 width,
    i32 height,
    i32 mipmaps,
    i32 format,
}

bind struct RenderTexture {
    i32 id,
    Texture texture,
    Texture depth,
}

bind struct NPatchInfo {
    Rectangle source,
    i32 left,
    i32 top,
    i32 right,
    i32 bottom,
    i32 layout,
}

bind struct GlyphInfo {
    i32 value,
    i32 offsetX,
    i32 offsetY,
    i32 advanceX,
    Image image,
}

bind struct Font {
    i32 baseSize,
    i32 glyphCount,
    i32 glyphPadding,
    Texture texture,
    Rectangle@ recs,
    GlyphInfo@ glyphs,
}

bind struct Camera3D {
    Vector3 position,
    Vector3 target,
    Vector3 up,
    f32 fovy,
    i32 projection,
}

bind struct Camera2D {
    Vector2 offset,
    Vector2 target,
    f32 rotation,
    f32 zoom,
}

bind struct Mesh {
    i32 vertexCount,
    i32 triangleCount,
    f32@ vertices,
    f32@ texcoords,
    f32@ texcoords2,
    f32@ normals,
    f32@ tangents,
    byte@ colors,
    i32@ indices,
    i32 boneCount,
    byte@ boneIndices,
    f32@ boneWeights,
    f32@ animVertices,
    f32@ animNormals,
    i32 vaoId,
    i32@ vboId,
}

bind struct Shader {
    i32 id,
    i32@ locs,
}

bind struct MaterialMap {
    Texture texture,
    Color color,
    f32 value,
}

bind struct Material {
    Shader shader,
    MaterialMap@ maps,
    f32[4] params,
}

bind struct Transform {
    Vector3 translation,
    Vector4 rotation,
    Vector3 scale,
}

bind struct BoneInfo {
    byte[32] name,
    i32 parent,
}

bind struct ModelSkeleton {
    i32 boneCount,
    BoneInfo@ bones,
    Transform@ bindPose,
}

bind struct Model {
    Matrix transform,
    i32 meshCount,
    i32 materialCount,
    Mesh@ meshes,
    Material@ materials,
    i32@ meshMaterial,
    ModelSkeleton skeleton,
    Transform@ currentPose,
    Matrix@ boneMatrices,
}

bind struct ModelAnimation {
    byte[32] name,
    i32 boneCount,
    i32 keyframeCount,
    Transform@@ keyframePoses,
}

bind struct Ray {
    Vector3 position,
    Vector3 direction,
}

bind struct RayCollision {
    bool hit,
    f32 distance,
    Vector3 point,
    Vector3 normal,
}

bind struct BoundingBox {
    Vector3 min,
    Vector3 max,
}

bind struct Wave {
    i32 frameCount,
    i32 sampleRate,
    i32 sampleSize,
    i32 channels,
    none@ data,
}

bind struct AudioStream {
    rAudioBuffer@ buffer,
    rAudioProcessor@ processor,
    i32 sampleRate,
    i32 sampleSize,
    i32 channels,
}

bind struct Sound {
    AudioStream stream,
    i32 frameCount,
}

bind struct Music {
    AudioStream stream,
    i32 frameCount,
    bool looping,
    i32 ctxType,
    none@ ctxData,
}

bind struct VrDeviceInfo {
    i32 hResolution,
    i32 vResolution,
    f32 hScreenSize,
    f32 vScreenSize,
    f32 eyeToScreenDistance,
    f32 lensSeparationDistance,
    f32 interpupillaryDistance,
    f32[4] lensDistortionValues,
    f32[4] chromaAbCorrection,
}

bind struct VrStereoConfig {
    Matrix[2] projection,
    Matrix[2] viewOffset,
    f32[2] leftLensCenter,
    f32[2] rightLensCenter,
    f32[2] leftScreenCenter,
    f32[2] rightScreenCenter,
    f32[2] scale,
    f32[2] scaleIn,
}

bind struct FilePathList {
    i32 count,
    byte@@ paths,
}

bind struct AutomationEvent {
    i32 frame,
    i32 type,
    i32[4] params,
}

bind struct AutomationEventList {
    i32 capacity,
    i32 count,
    AutomationEvent@ events,
}

bind enum ConfigFlags {
    FLAG_VSYNC_HINT,
    FLAG_FULLSCREEN_MODE,
    FLAG_WINDOW_RESIZABLE,
    FLAG_WINDOW_UNDECORATED,
    FLAG_WINDOW_HIDDEN,
    FLAG_WINDOW_MINIMIZED,
    FLAG_WINDOW_MAXIMIZED,
    FLAG_WINDOW_UNFOCUSED,
    FLAG_WINDOW_TOPMOST,
    FLAG_WINDOW_ALWAYS_RUN,
    FLAG_WINDOW_TRANSPARENT,
    FLAG_WINDOW_HIGHDPI,
    FLAG_WINDOW_MOUSE_PASSTHROUGH,
    FLAG_BORDERLESS_WINDOWED_MODE,
    FLAG_MSAA_4X_HINT,
    FLAG_INTERLACED_HINT,
}

bind enum TraceLogLevel {
    LOG_ALL,
    LOG_TRACE,
    LOG_DEBUG,
    LOG_INFO,
    LOG_WARNING,
    LOG_ERROR,
    LOG_FATAL,
    LOG_NONE,
}

